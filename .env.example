# PLUTO Web App Environment

NEXT_PUBLIC_APP_NAME="PLUTO Booking"
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Google Maps listing location picker.
# The map ID must be Maps Management -> JavaScript type, Vector or Raster.
# Enable billing, Maps JavaScript API, and Places API for the same Google Cloud project.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Feature flags
NEXT_PUBLIC_ENABLE_PARTNER_REGISTRATION=true
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true
