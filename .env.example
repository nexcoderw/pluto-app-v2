# PLUTO Web App Environment

NEXT_PUBLIC_APP_NAME="PLUTO Booking"
NEXT_PUBLIC_APP_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_XENTRIPAY_COLLECTION_FEE_BPS=300
NEXT_PUBLIC_PAYMENT_TAX_BPS=0

# Google Analytics
# Keep disabled during normal local development so test traffic does not
# pollute production analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Maps listing location picker.
# Server-only key used by local Next routes for Google Places search/details.
# Enable billing and Places API for the same Google Cloud project.
GOOGLE_MAPS_API_KEY=""

# Feature flags
NEXT_PUBLIC_ENABLE_PARTNER_REGISTRATION=true
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true