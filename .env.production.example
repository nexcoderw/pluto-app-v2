# PLUTO customer web production environment template
#
# Copy these values into the production deployment environment. Replace the
# server-only Google Maps credential with a real key and never expose it through
# a NEXT_PUBLIC_* variable.

NEXT_PUBLIC_APP_URL="https://plutobooking.com"
NEXT_PUBLIC_API_URL="https://api.plutobooking.com/api/v1"
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=true

# Server-only key used by Next.js Places proxy routes.
GOOGLE_MAPS_API_KEY="REPLACE_WITH_PRODUCTION_GOOGLE_MAPS_API_KEY"
